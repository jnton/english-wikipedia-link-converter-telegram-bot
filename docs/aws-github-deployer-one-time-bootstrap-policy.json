{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadDeploymentIdentity",
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*"
    },
    {
      "Sid": "ReadExistingBotExecutionRole",
      "Effect": "Allow",
      "Action": "lambda:GetFunctionConfiguration",
      "Resource": "arn:aws:lambda:eu-north-1:590183760311:function:ToEnWikipediaBot"
    },
    {
      "Sid": "CreateAndManageGitHubOidcProvider",
      "Effect": "Allow",
      "Action": [
        "iam:CreateOpenIDConnectProvider",
        "iam:GetOpenIDConnectProvider",
        "iam:AddClientIDToOpenIDConnectProvider",
        "iam:TagOpenIDConnectProvider"
      ],
      "Resource": "arn:aws:iam::590183760311:oidc-provider/token.actions.githubusercontent.com"
    },
    {
      "Sid": "CreateAndConfigureRepositoryDeploymentRole",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:GetRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:PutRolePolicy",
        "iam:TagRole"
      ],
      "Resource": "arn:aws:iam::590183760311:role/GitHubActions-ToEnWikipediaBot"
    }
  ]
}
